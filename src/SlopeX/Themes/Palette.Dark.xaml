<!--
    极简墨纸 —— 深色调色板

    与「极简白纸」成对：白纸以墨写字，墨纸以浅墨显字。
    刻意使用**暖调近黑**而不是纯黑 #000、也不用冷蓝灰——
    保留纸的质感，避免长时间看着发灰发硬。

    纸面层级的方向与浅色相反：浅色是"越深越强调"，
    深色是"越亮越强调"（悬停/选中的面比底色更亮）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 纸面层级 -->
    <!-- 窗口底色：必须始终不透明。
         插画主题的 Bg 是透明的（为了露出内容区插画），但窗口本身要实心，
         否则圆角外/侧栏处会透出桌面。 -->
    <SolidColorBrush x:Key="WindowBg" Color="#1A1A16"/>

    <SolidColorBrush x:Key="Bg" Color="#1A1A16"/>
    <!-- 卡片面：纸主题里与 Bg 同色；霓虹主题用它做"半透明卡片"。
         单独留一个 token，是为了让换肤时卡片与窗口底可以分开调。 -->
    <SolidColorBrush x:Key="Surface" Color="#1A1A16"/>
    <SolidColorBrush x:Key="Paper" Color="#232320"/>
    <SolidColorBrush x:Key="Paper2" Color="#2C2C27"/>
    <SolidColorBrush x:Key="Paper3" Color="#34342E"/>

    <!-- 描边 -->
    <SolidColorBrush x:Key="Line" Color="#35352F"/>
    <SolidColorBrush x:Key="LineStrong" Color="#4A4A42"/>

    <!-- 墨色文字（浅墨） -->
    <SolidColorBrush x:Key="Ink" Color="#EDEBE2"/>
    <SolidColorBrush x:Key="InkHover" Color="#FBFAF3"/>
    <SolidColorBrush x:Key="InkPressed" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Sub" Color="#A7A59B"/>
    <SolidColorBrush x:Key="Muted" Color="#7B7970"/>

    <!-- 语义色：深底上需要更高明度才够醒目 -->
    <SolidColorBrush x:Key="Good" Color="#57B98C"/>
    <SolidColorBrush x:Key="Warn" Color="#DDA05A"/>
    <SolidColorBrush x:Key="Bad" Color="#E5766C"/>
    <SolidColorBrush x:Key="CloseHover" Color="#C94248"/>

    <!-- 落在 Ink 上的前景色：深色主题里 Ink 是浅色，所以前景反而要深 -->
    <!-- 主按钮的强调色。纸质主题里就是墨色本身；插画主题改用品牌色，避免出现一大块白/黑按钮。 -->
    <SolidColorBrush x:Key="Primary" Color="#EDEBE2"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#D4D2C8"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#1A1A16"/>

    <SolidColorBrush x:Key="OnInk" Color="#1A1A16"/>

    <!-- 落在 Bad / CloseHover 上的前景色：红底用白字，两套主题一致 -->
    <SolidColorBrush x:Key="OnBad" Color="#FFFFFF"/>

    <!-- 模态遮罩：深色底本来就暗，需要更重的遮罩才能区分层次 -->
    <SolidColorBrush x:Key="Scrim" Color="#99000000"/>

</ResourceDictionary>
