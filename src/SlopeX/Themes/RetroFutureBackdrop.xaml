<UserControl x:Class="SlopeX.Themes.RetroFutureBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" ClipToBounds="True">

    <!--
        插画主题背景。

        图源不写进 XAML（<Image Source="pack://…">）——素材是可选的，缺失时那样写会
        在 InitializeComponent 直接抛异常。改由代码后置调用 ArtSource.TryLoad：
        拿到图就显示并隐藏 Fallback，拿不到就留着渐变当背景。

        图的上层叠两层处理：
        1) 顶部暗角 —— 白字标题区需要更深的底；
        2) 整体轻微压暗 —— 把饱和度留在边缘，中心让给卡片。
    -->

    <Grid>
        <!-- 缺图时的兜底：深紫夜空 + 底部洋红辉光 -->
        <Rectangle x:Name="Fallback">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1B0A3C" Offset="0"/>
                    <GradientStop Color="#2C0E52" Offset="0.55"/>
                    <GradientStop Color="#4A1050" Offset="0.82"/>
                    <GradientStop Color="#7A1B54" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Image x:Name="Art" Visibility="Collapsed"
               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- 顶部到中部的暗角 -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C000000" Offset="0"/>
                    <GradientStop Color="#4D000000" Offset="0.35"/>
                    <GradientStop Color="#26000000" Offset="0.7"/>
                    <GradientStop Color="#1A000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
