<!--
    复古未来 —— 第三套主题（深紫底 + 合成波暮色位图）

    与两套纸质主题的区别：这一套允许"图"参与界面 —— Bg 透明，
    由 RetroFutureBackdrop 在位图背景上作画；背景插画是可选的（不进仓库），
    缺失时该控件退回纯渐变。Paper 系列带 alpha，卡片会透出一点背景，形成纵深。

    约束：
    - 所有引用仍必须 DynamicResource。
    - 文字色必须保证在"卡片叠在插画上"时依然可读，
      所以 Ink/Sub/Muted 都偏亮，Paper 的不透明度不低于 0.9。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基础面：透明，露出插画 -->
    <!-- 窗口底色：必须始终不透明。
         插画主题的 Bg 是透明的（为了露出内容区插画），但窗口本身要实心，
         否则圆角外/侧栏处会透出桌面。 -->
    <SolidColorBrush x:Key="WindowBg" Color="#1B0A3C"/>

    <SolidColorBrush x:Key="Bg" Color="#00000000"/>

    <!-- 卡片面：95% 不透明——够透出一点背景插画，又不至于让文字发虚 -->
    <SolidColorBrush x:Key="Surface" Color="#F51B0A3C"/>

    <!-- 纸面层级：半透明的深紫，越高层越亮 -->
    <SolidColorBrush x:Key="Paper" Color="#FA26103D"/>
    <SolidColorBrush x:Key="Paper2" Color="#FB33164F"/>
    <SolidColorBrush x:Key="Paper3" Color="#FB40205F"/>

    <!-- 描边 -->
    <SolidColorBrush x:Key="Line" Color="#4E2270"/>
    <SolidColorBrush x:Key="LineStrong" Color="#7238A6"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Ink" Color="#FFF0FA"/>
    <SolidColorBrush x:Key="InkHover" Color="#FFD9F2"/>
    <SolidColorBrush x:Key="InkPressed" Color="#F7C0E4"/>
    <SolidColorBrush x:Key="Sub" Color="#E0BCF0"/>
    <SolidColorBrush x:Key="Muted" Color="#AE8CCC"/>

    <!-- 语义色：霓虹系的青 / 琥珀 / 品红 -->
    <SolidColorBrush x:Key="Good" Color="#4FE3C1"/>
    <SolidColorBrush x:Key="Warn" Color="#FFC65C"/>
    <SolidColorBrush x:Key="Bad" Color="#FF4F7E"/>
    <SolidColorBrush x:Key="CloseHover" Color="#E0366A"/>

    <!-- 反色（深色主题里主按钮是亮粉，字用深紫） -->
    <!-- 主按钮的强调色。纸质主题里就是墨色本身；插画主题改用品牌色，避免出现一大块白/黑按钮。 -->
    <SolidColorBrush x:Key="Primary" Color="#FF2D95"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FF4FA5"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#E0207F"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#2B0A33"/>

    <SolidColorBrush x:Key="OnInk" Color="#1B0A3C"/>
    <SolidColorBrush x:Key="OnBad" Color="#FFFFFF"/>

    <!-- 遮罩：带一点紫，压暗时仍保留暮色 -->
    <SolidColorBrush x:Key="Scrim" Color="#B30D0320"/>
</ResourceDictionary>
