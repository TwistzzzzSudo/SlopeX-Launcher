<UserControl x:Class="SlopeX.Themes.ViceCityBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" ClipToBounds="True">

    <!--
        ViceCity 背景：art/vicecity.jpg（1920×1344，与内容区同比例）

        插画本身很亮，直接铺会让页面标题读不清，所以叠了两层处理：
        1) 顶部暗角 —— 白字标题区需要更深的底；
        2) 整体轻微压暗 —— 把饱和度留在边缘，中心让给卡片。
    -->

    <Grid>
        <Image Source="pack://application:,,,/Assets/vicecity.jpg"
               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C000000" Offset="0"/>
                    <GradientStop Color="#4D000000" Offset="0.35"/>
                    <GradientStop Color="#26000000" Offset="0.7"/>
                    <GradientStop Color="#1A000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
