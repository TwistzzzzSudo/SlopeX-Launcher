<UserControl x:Class="SlopeX.Themes.ViceCityBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" ClipToBounds="True">

    <!--
        ViceCity 背景。图源由代码后置加载（同 RetroFutureBackdrop 的理由）：
        素材不进仓库，XAML 里硬写 pack:// 会在缺失时抛异常。

        插画本身很亮，直接铺会让页面标题读不清，所以叠两层：
        1) 顶部暗角；2) 整体轻微压暗。
    -->

    <Grid>
        <!-- 缺图时的兜底：暮色粉橙渐变 -->
        <Rectangle x:Name="Fallback">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C0716" Offset="0"/>
                    <GradientStop Color="#3A0E2C" Offset="0.5"/>
                    <GradientStop Color="#79204A" Offset="0.82"/>
                    <GradientStop Color="#C2416A" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Image x:Name="Art" Visibility="Collapsed"
               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C000000" Offset="0"/>
                    <GradientStop Color="#4D000000" Offset="0.35"/>
                    <GradientStop Color="#26000000" Offset="0.7"/>
                    <GradientStop Color="#1A000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
