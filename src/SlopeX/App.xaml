<Application x:Class="SlopeX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 调色板必须排在 Style 之前：Style 里的颜色引用是 DynamicResource，
                     运行时由 ThemeService 把这一份整体替换掉（浅色 ↔ 深色）。 -->
                <ResourceDictionary Source="Themes/Palette.Light.xaml"/>
                <ResourceDictionary Source="Themes/Style.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
