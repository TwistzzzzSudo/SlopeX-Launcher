<UserControl x:Class="SlopeX.Pages.PageAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SlopeX.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="34,26,34,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource TTitle}" Text="账号"/>
            <TextBlock Style="{StaticResource TSub}" Margin="0,5,0,0"
                       Text="正版登录、离线昵称与皮肤预览。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      controls:ScrollAssist.Smooth="True">

            <StackPanel Margin="0,0,0,24">

                <!-- 账号状态 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="登录状态"/>
                        <TextBlock x:Name="AccountStatus" Style="{StaticResource TSub}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="玩家名"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="InputName" Grid.Column="1" Style="{StaticResource Input}"
                                     MaxWidth="300" HorizontalAlignment="Left" Width="300"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource TCaption}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="离线模式下生效"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnLogin" Style="{StaticResource BtnGhost}" Content="登录微软账号"
                                    Click="Login_Click"/>
                            <Button x:Name="BtnLogout" Style="{StaticResource BtnGhost}" Content="退出登录"
                                    Margin="8,0,0,0" Visibility="Collapsed" Click="Logout_Click"/>
                            <Button x:Name="BtnSaveName" Style="{StaticResource BtnGhost}" Content="保存玩家名"
                                    Margin="8,0,0,0" Click="SaveName_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 皮肤 -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 预览：拖动旋转，双击回正面 -->
                        <Border Grid.Column="0" Width="248" Height="404"
                                Background="{DynamicResource Paper2}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="{StaticResource R10}" ClipToBounds="True">
                            <controls:SkinPreview x:Name="SkinView"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="24,2,0,0">
                            <TextBlock Style="{StaticResource TSection}" Text="皮肤"/>

                            <TextBlock x:Name="SkinHint" Style="{StaticResource TCaption}" Margin="0,6,0,14"
                                       TextWrapping="Wrap"
                                       Text="拖动预览可以旋转视角，双击回到正面。"/>

                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ChipPremium" Style="{StaticResource Chip}" Content="正版皮肤"
                                              Click="SkinSource_Click"/>
                                <ToggleButton x:Name="ChipOffline" Style="{StaticResource Chip}" Content="离线皮肤"
                                              Click="SkinSource_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="SkinDetail" Style="{StaticResource TCaption}" Margin="0,14,0,0"
                                       TextWrapping="Wrap"/>

                            <Button x:Name="BtnUpload" Style="{StaticResource BtnGhost}" Content="选择皮肤文件"
                                    HorizontalAlignment="Left" Margin="0,16,0,0" Click="Upload_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
