<UserControl x:Class="SlopeX.Pages.PageTasks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="34,26,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Style="{StaticResource TTitle}" Text="任务与日志"/>
                <TextBlock Style="{StaticResource TSub}" Margin="0,5,0,0"
                           Text="安装进度、下载详情与游戏运行日志。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnGhost}" Content="清空日志" Click="ClearLog_Click"/>
                <Button Style="{StaticResource BtnGhost}" Content="打开日志目录" Margin="8,0,0,0"
                        Click="OpenLogDir_Click"/>
            </StackPanel>
        </Grid>

        <!-- 任务列表 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <ScrollViewer x:Name="TaskScroll" MaxHeight="212" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                        Padding="4,10,4,12">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TBody}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource TCaption}"
                                                           Margin="8,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SpeedText}" Style="{StaticResource TCaption}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource TMono}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Style="{StaticResource BtnText}" Content="取消" Height="24"
                                                        Tag="{Binding}" Click="CancelTask_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar Style="{StaticResource Bar}" Margin="0,9,0,0"
                                                     Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>

                                        <Grid Margin="0,7,0,0">
                                            <TextBlock Text="{Binding Stage}" Style="{StaticResource TCaption}"/>
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource TCaption}"
                                                       Foreground="{DynamicResource Bad}"
                                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="360"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="NoTaskPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,16,0,16">
                    <TextBlock Style="{StaticResource EmptyTitle}" Text="暂无任务"/>
                    <TextBlock Style="{StaticResource EmptyHint}"
                               Text="去「下载」页安装一个版本，或导入整合包，任务会出现在这里"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                        Padding="14,10,14,10">
                    <Grid>
                        <TextBlock Text="运行日志" Style="{StaticResource TCaption}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LogCount" Style="{StaticResource TCaption}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         Background="{DynamicResource Bg}" Foreground="{DynamicResource Sub}"
                         FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                         Padding="14,10,10,10"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         IsReadOnlyCaretVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
