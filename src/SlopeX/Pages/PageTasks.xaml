<UserControl x:Class="SlopeX.Pages.PageTasks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="34,26,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Style="{StaticResource TTitle}" Text="任务与日志"/>
                <TextBlock Style="{StaticResource TSub}" Margin="0,5,0,0"
                           Text="安装进度、下载详情与游戏运行日志。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnGhost}" Content="导出日志" Click="ExportLog_Click"/>
                <Button Style="{StaticResource BtnGhost}" Content="打开日志目录" Margin="8,0,0,0"
                        Click="OpenLogDir_Click"/>
                <Button Style="{StaticResource BtnGhost}" Content="清空日志" Margin="8,0,0,0"
                        Click="ClearLog_Click"/>
            </StackPanel>
        </Grid>

        <!-- 任务列表 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <ScrollViewer x:Name="TaskScroll" MaxHeight="212" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                        Padding="4,10,4,12">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TBody}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource TCaption}"
                                                           Margin="8,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SpeedText}" Style="{StaticResource TCaption}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource TMono}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Style="{StaticResource BtnText}" Content="暂停" Height="24"
                                                        Margin="8,0,0,0" Tag="{Binding}" Click="PauseTask_Click"
                                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"/>
                                                <Button Style="{StaticResource BtnText}" Content="继续" Height="24"
                                                        Margin="8,0,0,0" Tag="{Binding}" Click="ResumeTask_Click"
                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"/>
                                                <Button Style="{StaticResource BtnText}" Content="重试" Height="24"
                                                        Margin="8,0,0,0" Tag="{Binding}" Click="RetryTask_Click"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"/>
                                                <Button Style="{StaticResource BtnText}" Content="取消" Height="24"
                                                        Margin="8,0,0,0" Tag="{Binding}" Click="CancelTask_Click"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                                <Button Style="{StaticResource BtnText}" Content="移除" Height="24"
                                                        Margin="8,0,0,0" Tag="{Binding}" Click="RemoveTask_Click"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar Style="{StaticResource Bar}" Margin="0,9,0,0"
                                                     Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>

                                        <Grid Margin="0,7,0,0">
                                            <TextBlock Text="{Binding Stage}" Style="{StaticResource TCaption}"/>
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource TCaption}"
                                                       Foreground="{DynamicResource Bad}"
                                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="360"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="NoTaskPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,16,0,16">
                    <TextBlock Style="{StaticResource EmptyTitle}" Text="暂无任务"/>
                    <TextBlock Style="{StaticResource EmptyHint}"
                               Text="去「下载」页安装一个版本，或导入整合包，任务会出现在这里"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                        Padding="14,8,14,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="运行日志" Style="{StaticResource TCaption}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <!-- 搜索：边打边找（180ms 防抖），命中会标出来并滚到对应行 -->
                            <Grid Width="228" Margin="16,0,0,0">
                                <TextBox x:Name="LogSearch" Style="{StaticResource Input}" Height="28" Padding="9,0"
                                         TextChanged="LogSearch_TextChanged"
                                         PreviewKeyDown="LogSearch_PreviewKeyDown"/>
                                <TextBlock Text="搜索日志" Foreground="{DynamicResource Muted}" FontSize="12"
                                           Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=LogSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock x:Name="SearchCount" Style="{StaticResource TCaption}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" MinWidth="46"/>

                            <StackPanel x:Name="SearchNav" Orientation="Horizontal" Visibility="Collapsed">
                                <Button Style="{StaticResource BtnText}" Width="24" Height="24" Padding="0"
                                        FontFamily="Segoe MDL2 Assets" FontSize="10" Content="&#xE70E;"
                                        ToolTip="上一个匹配（Shift+Enter）" Click="PrevHit_Click"/>
                                <Button Style="{StaticResource BtnText}" Width="24" Height="24" Padding="0"
                                        FontFamily="Segoe MDL2 Assets" FontSize="10" Content="&#xE70D;"
                                        ToolTip="下一个匹配（Enter）" Click="NextHit_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="LogCount" Style="{StaticResource TCaption}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 命中标记用一层 Canvas 画在文字底下：TextBox 的选中色只在「自己拿到过焦点」
                     的时候才渲染，搜索框有焦点时它不画，所以不能靠 Select() 来标位置。 -->
                <Grid Grid.Row="1" Background="{DynamicResource Bg}" ClipToBounds="True">
                    <Canvas x:Name="LogHighlight" IsHitTestVisible="False" ClipToBounds="True"/>

                    <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             Background="Transparent" Foreground="{DynamicResource Sub}"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                             Padding="14,10,10,10"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             IsReadOnlyCaretVisible="False"
                             IsInactiveSelectionHighlightEnabled="True"
                             SelectionBrush="{DynamicResource Ink}" SelectionOpacity="0.24"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
