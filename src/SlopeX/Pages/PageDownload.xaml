<UserControl x:Class="SlopeX.Pages.PageDownload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="34,26,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Style="{StaticResource TTitle}" Text="下载"/>
                <TextBlock x:Name="SubTitle" Style="{StaticResource TSub}" Margin="0,5,0,0"
                           Text="从版本清单安装原版游戏。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock x:Name="SourceHint" Style="{StaticResource TCaption}" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Button Style="{StaticResource BtnGhost}" Content="刷新清单" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ToggleButton x:Name="ChipAll" Style="{StaticResource Chip}" Content="全部" Tag="all"
                              IsChecked="True" Click="Chip_Click"/>
                <ToggleButton x:Name="ChipRelease" Style="{StaticResource Chip}" Content="正式版" Tag="release"
                              Click="Chip_Click"/>
                <ToggleButton x:Name="ChipSnapshot" Style="{StaticResource Chip}" Content="快照" Tag="snapshot"
                              Click="Chip_Click"/>
                <ToggleButton x:Name="ChipOld" Style="{StaticResource Chip}" Content="远古版本" Tag="old"
                              Click="Chip_Click"/>
            </StackPanel>
            <Grid HorizontalAlignment="Right" Width="240">
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                         TextChanged="SearchBox_TextChanged" ToolTip="输入版本号搜索"/>
                <TextBlock Text="搜索版本号…" Foreground="{StaticResource Muted}" FontSize="12.5"
                           Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ListBox x:Name="VersionList" Style="{StaticResource PlainList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,4,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}"/>
                                    <TextBlock Text="{Binding DateLabel}" Style="{StaticResource TCaption}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource Tag}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                                               Foreground="{StaticResource Sub}"/>
                                </Border>

                                <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Height="30"
                                        Padding="14,0" Content="{Binding InstallLabel}"
                                        IsEnabled="{Binding CanInstall}" Tag="{Binding Id}"
                                        Click="Install_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="StatusText" Style="{StaticResource TSub}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Text="正在获取版本清单…"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
