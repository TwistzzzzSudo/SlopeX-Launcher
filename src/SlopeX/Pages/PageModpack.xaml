<UserControl x:Class="SlopeX.Pages.PageModpack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <!--
        整合包页：搜索（Modrinth / CurseForge / MC百科 中文）→ 挑包版本 → 下载归档 → 交给任务中心安装。
        安装本身复用 ModpackInstaller（它已经能处理 .mrpack 与 CurseForge 清单），这里只管取包。
    -->

    <UserControl.Resources>
        <!-- 版本浮层里的一行：整行就是按钮，点中直接开下载（与资源包面板同一套做法） -->
        <Style x:Key="VersionPickRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R8}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Paper2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Paper3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="34,26,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource TTitle}" Text="整合包"/>
                <TextBlock x:Name="SubTitle" Style="{StaticResource TSub}" Margin="0,5,0,0"
                           Text="从 Modrinth 与 CurseForge 下载；中文关键词经 MC百科 找对应项目。"/>
            </StackPanel>
            <Button Style="{StaticResource BtnGhost}" Content="刷新" Click="Refresh_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- 来源 + 搜索 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="ChipAll" Style="{StaticResource Chip}" Content="全部"
                              IsChecked="True" Click="Filter_Click"/>
                <ToggleButton x:Name="ChipModrinth" Style="{StaticResource Chip}" Content="Modrinth"
                              Margin="8,0,0,0" Click="Filter_Click"/>
                <ToggleButton x:Name="ChipCurseForge" Style="{StaticResource Chip}" Content="CurseForge"
                              Margin="8,0,0,0" Click="Filter_Click"/>
            </StackPanel>

            <Grid HorizontalAlignment="Right" Width="380">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="QueryBox" Style="{StaticResource Input}" KeyDown="Query_KeyDown"/>
                    <TextBlock Text="搜索整合包，如 all the mods、宝可梦…"
                               Foreground="{DynamicResource Muted}" FontSize="12.5"
                               Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="搜索" Margin="8,0,0,0"
                        Click="Search_Click"/>
            </Grid>
        </Grid>

        <!-- 状态行 + 下载进度 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Style="{StaticResource TCaption}" TextWrapping="Wrap"
                       Text="输入关键词搜索；点结果行的「安装」，挑一个包版本就会开始下载。"/>

            <StackPanel x:Name="ProgressRow" Margin="0,6,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" Style="{StaticResource TCaption}"
                           HorizontalAlignment="Right" Text=""/>
                <ProgressBar x:Name="DownloadBar" Style="{StaticResource Bar}" Height="4"
                             Margin="0,4,0,0" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </StackPanel>

        <!-- 列表 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="112"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource DataListHeader}" Text="名称"/>
                <TextBlock Grid.Column="1" Style="{StaticResource DataListHeader}" Text="支持版本"/>
                <TextBlock Grid.Column="2" Style="{StaticResource DataListHeader}" Text="更新"/>
                <TextBlock Grid.Column="3" Style="{StaticResource DataListHeader}" Text="操作"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox x:Name="PackList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DataListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="196"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 平台项目图标；没有时显示首字母占位 -->
                                            <Grid Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border CornerRadius="8" Background="{DynamicResource Paper2}"/>
                                                <TextBlock Text="{Binding Hit.Initial}" FontSize="14"
                                                           Foreground="{DynamicResource Muted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Hit.IconData, Converter={StaticResource Icon}}"
                                                                    Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="360"
                                                           ToolTip="{Binding TooltipText}"/>
                                                <TextBlock Text="{Binding SubTitle}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="360"
                                                           ToolTip="{Binding Description}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   Style="{StaticResource TCaption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding SupportText}"/>

                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   Style="{StaticResource TCaption}"
                                                   Text="{Binding UpdatedText}"/>

                                        <Button Grid.Column="3" Style="{StaticResource BtnText}" Tag="{Binding}"
                                                Click="ChooseVersion_Click" MinWidth="78"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                AutomationProperties.Name="安装"
                                                ToolTip="选一个包版本，点完立刻开始下载">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="安装"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="9" Margin="5,1,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" Style="{StaticResource EmptyTitle}"
                                   Text="还没有搜到整合包"/>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource EmptyHint}"
                                   Text="上面输入关键词，比如 all the mods、宝可梦、RLCraft"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <!-- 版本选择浮层：点「安装」时贴在该按钮下方，点中哪个版本就开始下载哪个 -->
    <Popup x:Name="VersionPopup" StaysOpen="False" AllowsTransparency="True"
           Placement="Bottom" VerticalOffset="4" HorizontalOffset="-40"
           PopupAnimation="Fade">
        <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource R8}"
                BorderThickness="1" BorderBrush="{StaticResource Line}" Padding="4"
                Width="360" MaxHeight="320">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="VersionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource VersionPickRow}" Tag="{Binding}"
                                    Click="VersionPick_Click" ToolTip="{Binding FileName}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="12.5"
                                               Foreground="{DynamicResource Ink}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SubText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        </Popup>
    </Grid>
</UserControl>
