<UserControl x:Class="SlopeX.Pages.PageVersions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="34,26,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Style="{StaticResource TTitle}" Text="版本管理"/>
                <TextBlock x:Name="SubTitle" Style="{StaticResource TSub}" Margin="0,5,0,0"
                           Text="扫描游戏目录下所有已安装的版本。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnGhost}" Content="打开目录" Click="OpenFolder_Click"/>
                <Button Style="{StaticResource BtnGhost}" Content="重新扫描" Margin="8,0,0,0"
                        Click="Refresh_Click"/>
                <Button Style="{StaticResource BtnGhost}" Content="导入整合包" Margin="8,0,0,0"
                        ToolTip="支持 .mrpack、CurseForge 整合包 zip、MultiMC / Prism 实例、普通 mods 压缩包"
                        Click="ImportPack_Click"/>
                <Button Style="{StaticResource BtnPrimary}" Content="安装新版本" Height="32" Padding="18,0"
                        Margin="8,0,0,0" Click="GoDownload_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid HorizontalAlignment="Left" Width="260">
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                         TextChanged="SearchBox_TextChanged" ToolTip="按版本名过滤"/>
                <TextBlock Text="搜索版本…" Foreground="{DynamicResource Muted}" FontSize="12.5"
                           Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock Style="{StaticResource TCaption}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="双击版本可立即启动"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,8,8,8">
            <Grid>
                <ListBox x:Name="VersionList" Style="{StaticResource PlainList}"
                         SelectionChanged="VersionList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3,4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                        <Border Style="{StaticResource Tag}" Margin="8,0,0,0"
                                                Background="{DynamicResource Paper2}">
                                            <TextBlock Text="{Binding Loader}" FontSize="11"
                                                       Foreground="{DynamicResource Sub}"/>
                                        </Border>
                                        <Border Style="{StaticResource Tag}" Margin="6,0,0,0"
                                                Background="{DynamicResource Paper2}"
                                                Visibility="{Binding IsPack, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="整合包" FontSize="11"
                                                       Foreground="{DynamicResource Sub}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TCaption}" Margin="0,3,0,0">
                                        <Run Text="基础版本 "/>
                                        <Run Text="{Binding BaseVersion, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding CreatedHint, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="10,0,6,0">
                                    <Button Style="{StaticResource BtnText}" Content="启动" Click="LaunchOne_Click"
                                            Tag="{Binding Id}"/>
                                    <Button Style="{StaticResource BtnText}" Content="目录" Click="OpenOne_Click"
                                            Tag="{Binding Dir}"/>
                                    <Button Style="{StaticResource BtnText}" Content="删除" Click="DeleteOne_Click"
                                            Tag="{Binding Id}" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center" Margin="4,0,6,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource EmptyTitle}"
                               Text="还没有安装任何版本"/>
                    <TextBlock x:Name="EmptyHintText" Style="{StaticResource EmptyHint}"
                               Text="点右上角「安装新版本」开始，或导入一个整合包"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
