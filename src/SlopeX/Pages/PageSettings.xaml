<UserControl x:Class="SlopeX.Pages.PageSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SlopeX.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="34,26,34,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Style="{StaticResource TTitle}" Text="设置"/>
                <TextBlock Style="{StaticResource TSub}" Margin="0,5,0,0"
                           Text="主题即时生效；其余项点「保存设置」后生效。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnGhost}" Content="恢复默认" Click="Reset_Click"/>
                <Button Style="{StaticResource BtnPrimary}" Content="保存设置" Height="32" Padding="18,0"
                        Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      controls:ScrollAssist.Smooth="True">
            <StackPanel Margin="0,0,16,26">

                <!-- 主题 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="主题" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ChipThemeSystem" Style="{StaticResource Chip}" Content="跟随系统"
                                          Click="ThemeChip_Click"/>
                            <ToggleButton x:Name="ChipThemeLight" Style="{StaticResource Chip}" Content="极简白纸"
                                          Click="ThemeChip_Click"/>
                            <ToggleButton x:Name="ChipThemeDark" Style="{StaticResource Chip}" Content="极简墨纸"
                                          Click="ThemeChip_Click"/>
                            <ToggleButton x:Name="ChipThemeRetro" Style="{StaticResource Chip}" Content="复古未来"
                                          Click="ThemeChip_Click"/>
                            <ToggleButton x:Name="ChipThemeVice" Style="{StaticResource Chip}" Content="ViceCity"
                                          Click="ThemeChip_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 账号已独立成页（左侧「账号」），这里不再重复 -->

                <!-- 游戏目录 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="游戏目录"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="默认在启动器目录下的 .minecraft，可改。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="目录"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="InputGameDir" Grid.Column="1" Style="{StaticResource Input}"
                                     Height="34"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="浏览"
                                    Margin="8,0,0,0" Click="BrowseGameDir_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Java -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="Java 运行时" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="自定义路径"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="InputJava" Grid.Column="1" Style="{StaticResource Input}"
                                     Height="34"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnGhost}" Content="浏览" Margin="8,0,0,0"
                                        Click="BrowseJava_Click"/>
                                <Button Style="{StaticResource BtnGhost}" Content="自动检测" Margin="8,0,0,0"
                                        Click="DetectJava_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource HRule}" Margin="0,14,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="已检测"
                                       VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <ListBox x:Name="JavaList" Grid.Column="1" Style="{StaticResource PlainList}"
                                     MaxHeight="150" SelectionChanged="JavaList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}" Style="{StaticResource TBody}"/>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource TMono}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}"
                                                       Style="{StaticResource TCaption}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Style="{StaticResource HRule}" Margin="0,14,0,12"/>
                        <CheckBox x:Name="ChkAutoJava" Style="{StaticResource Chk}"
                                  Content="缺少所需 Java 时自动下载安装（使用国内镜像）"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="24,8,0,0" TextWrapping="Wrap"
                                   Text="镜像顺序：清华 TUNA → 中科大 → 华为云。每个主版本约 50 MB。"/>
                    </StackPanel>
                </Border>

                <!-- 性能 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="性能"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="内存过小会导致大型整合包崩溃，建议 4096 MB 以上。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="最大内存 (MB)"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnGhost}" Content="−" Width="34" Height="34"
                                        Padding="0" Click="MemoryMinus_Click"/>
                                <TextBox x:Name="InputMemory" Style="{StaticResource Input}" Width="100"
                                         Margin="8,0,8,0" TextAlignment="Center"/>
                                <Button Style="{StaticResource BtnGhost}" Content="+" Width="34" Height="34"
                                        Padding="0" Click="MemoryPlus_Click"/>
                                <TextBlock x:Name="MemoryHint" Style="{StaticResource TCaption}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="附加 JVM 参数"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="InputJvm" Grid.Column="1" Style="{StaticResource Input}"
                                     Height="34" ToolTip="例如 -XX:+UseG1GC"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 启动 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="启动"/>
                        <StackPanel Margin="0,14,0,0">
                            <CheckBox x:Name="ChkResolution" Style="{StaticResource Chk}" Content="自定义窗口分辨率"/>
                            <Grid Margin="24,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InputWidth" Grid.Column="0" Style="{StaticResource Input}"
                                         Width="80" TextAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="×" Style="{StaticResource TSub}"
                                           Margin="10,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="InputHeight" Grid.Column="2" Style="{StaticResource Input}"
                                         Width="80" TextAlignment="Center"/>
                            </Grid>
                            <CheckBox x:Name="ChkMinimize" Style="{StaticResource Chk}" Margin="0,14,0,0"
                                      Content="启动游戏后最小化启动器"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 下载 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="下载源"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="国内网络建议使用 BMCLAPI 镜像，速度更快。"/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ChipMirror" Style="{StaticResource Chip}" Content="BMCLAPI 镜像"
                                          Click="Source_Click"/>
                            <ToggleButton x:Name="ChipOfficial" Style="{StaticResource Chip}" Content="Mojang 官方"
                                          Click="Source_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 下载线程 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="下载线程"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Text="单个文件的最大并发连接数，默认 16。国内单条连接常被限速到几十 KB/s，调高能明显提速；网络不稳或路由器容易掉线时调低。选 32 / 64 会先弹一次风险提示。"/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ChipThread8" Style="{StaticResource Chip}" Content="8"
                                          Click="Thread_Click" ToolTip="保守：对路由器压力最小"/>
                            <ToggleButton x:Name="ChipThread16" Style="{StaticResource Chip}" Content="16"
                                          Margin="8,0,0,0" Click="Thread_Click" ToolTip="默认：速度与稳定兼顾"/>
                            <ToggleButton x:Name="ChipThread32" Style="{StaticResource Chip}" Content="32"
                                          Margin="8,0,0,0" Click="Thread_Click" ToolTip="单连接限速严重时更快，需要先确认"/>
                            <ToggleButton x:Name="ChipThread64" Style="{StaticResource Chip}" Content="64"
                                          Margin="8,0,0,0" Click="Thread_Click" ToolTip="最快，也最容易触发路由器连接数上限，需要先确认"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="关于"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="版本"/>
                            <TextBlock x:Name="VersionText" Grid.Column="1" Style="{StaticResource TBody}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="配置文件"/>
                            <TextBlock x:Name="ConfigPath" Grid.Column="1" Style="{StaticResource TMono}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="更新"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="UpdateHint" Style="{StaticResource TBody}"
                                           Text="尚未检查" VerticalAlignment="Center"/>
                                <Button x:Name="CheckUpdateBtn" Style="{StaticResource BtnGhost}"
                                        Content="检查更新" Height="30" Margin="12,0,0,0"
                                        Click="CheckUpdate_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Button Style="{StaticResource BtnGhost}" Content="打开配置目录" Height="30"
                                    HorizontalAlignment="Left" Click="OpenConfigDir_Click"/>
                            <TextBlock Style="{StaticResource TCaption}" Text="Program By ShakableCat · DeepSeek"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 法律声明 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="法律声明"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="非商业使用限制、权利通知与联系方式。使用本启动器即视为同意全部条款。"/>
                        <Button Style="{StaticResource BtnGhost}" Content="查看" Height="30"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenLegal_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
