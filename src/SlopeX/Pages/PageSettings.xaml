<UserControl x:Class="SlopeX.Pages.PageSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="34,26,34,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Style="{StaticResource TTitle}" Text="设置"/>
                <TextBlock Style="{StaticResource TSub}" Margin="0,5,0,0"
                           Text="主题即时生效；其余项点「保存设置」后生效。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnGhost}" Content="恢复默认" Click="Reset_Click"/>
                <Button Style="{StaticResource BtnPrimary}" Content="保存设置" Height="32" Padding="18,0"
                        Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,26">

                <!-- 主题 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="主题"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Text="默认「极简白纸」，可跟随 Windows 深浅色。"/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ChipThemeSystem" Style="{StaticResource Chip}" Content="跟随系统"
                                          Click="ThemeChip_Click"/>
                            <ToggleButton x:Name="ChipThemeLight" Style="{StaticResource Chip}" Content="极简白纸"
                                          Click="ThemeChip_Click"/>
                            <ToggleButton x:Name="ChipThemeDark" Style="{StaticResource Chip}" Content="极简墨纸"
                                          Click="ThemeChip_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ThemeHint" Style="{StaticResource TCaption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 账号 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="账号"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="当前为离线登录：仅填写玩家名，不校验正版账号。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="玩家名"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="InputName" Grid.Column="1" Style="{StaticResource Input}"
                                     MaxWidth="300" HorizontalAlignment="Left" Width="300"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource TCaption}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Text="用于游戏内显示名"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 游戏目录 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="游戏目录"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="默认在启动器目录下的 .minecraft，可改。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="目录"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="InputGameDir" Grid.Column="1" Style="{StaticResource Input}"
                                     Height="34"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="浏览"
                                    Margin="8,0,0,0" Click="BrowseGameDir_Click"/>
                        </Grid>

                        <Border Style="{StaticResource HRule}" Margin="0,16,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TBody}" Text="存档隔离" VerticalAlignment="Center"
                                       ToolTip="每个版本固定使用 .minecraft\versions\&lt;版本 ID&gt; 作为游戏目录：存档、材质包、模组、设置互不影响；libraries 与 assets 仍然共用。&#10;需要跨版本共用存档时，请自行把存档文件夹复制到目标版本的 saves 目录——启动器不会自动共享，也不会自动搬移。"/>
                            <Border Style="{StaticResource Tag}" Margin="8,0,0,0">
                                <TextBlock Text="强制" FontSize="11" Foreground="{DynamicResource Sub}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SavesPathText" Style="{StaticResource TMono}" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <Grid x:Name="LegacySavesRow" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LegacySavesHint" Grid.Column="0" Style="{StaticResource TCaption}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Warn}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnText}" Content="不再提示"
                                    FontSize="11.5" Padding="8,0" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Click="DismissLegacySaves_Click"/>
                        </Grid>
                        <Button Style="{StaticResource BtnGhost}" Height="30" Padding="12,0" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Content="打开该版本存档目录" Click="OpenSaves_Click"/>
                    </StackPanel>
                </Border>

                <!-- Java -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="Java 运行时"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="留空则按版本自动选择（以版本 JSON 的 javaVersion 为准）。1.17 需 16+，1.18+ 需 17+，1.20.5+ 需 21+，26.x 需 25。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="自定义路径"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="InputJava" Grid.Column="1" Style="{StaticResource Input}"
                                     Height="34"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnGhost}" Content="浏览" Margin="8,0,0,0"
                                        Click="BrowseJava_Click"/>
                                <Button Style="{StaticResource BtnGhost}" Content="自动检测" Margin="8,0,0,0"
                                        Click="DetectJava_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource HRule}" Margin="0,14,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="已检测"
                                       VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <ListBox x:Name="JavaList" Grid.Column="1" Style="{StaticResource PlainList}"
                                     MaxHeight="150" SelectionChanged="JavaList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}" Style="{StaticResource TBody}"/>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource TMono}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}"
                                                       Style="{StaticResource TCaption}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Border Style="{StaticResource HRule}" Margin="0,14,0,12"/>
                        <CheckBox x:Name="ChkAutoJava" Style="{StaticResource Chk}"
                                  Content="缺少所需 Java 时自动下载安装（使用国内镜像）"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="24,8,0,0" TextWrapping="Wrap"
                                   Text="镜像顺序：清华 TUNA → 中科大 → 华为云。每个主版本约 50 MB，装到下方「运行时目录」。"/>
                    </StackPanel>
                </Border>

                <!-- 数据与运行时 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="数据与运行时"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="配置与日志的位置；在启动器目录内即可随文件夹一起搬走。"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="数据目录"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="DataDirText" Grid.Column="1" Style="{StaticResource TMono}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="打开"
                                    Margin="8,0,0,0" Click="OpenDataDir_Click"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="运行时目录"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="InputRuntimeDir" Grid.Column="1" Style="{StaticResource Input}"
                                     Height="34"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnGhost}" Content="浏览" Margin="8,0,0,0"
                                        Click="BrowseRuntimeDir_Click"/>
                                <Button Style="{StaticResource BtnGhost}" Content="恢复默认" Margin="8,0,0,0"
                                        Click="ResetRuntimeDir_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="RuntimeDirHint" Style="{StaticResource TCaption}" Margin="112,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 性能 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="性能"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="内存过小会导致大型整合包崩溃，建议 4096 MB 以上。"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="最大内存 (MB)"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnGhost}" Content="−" Width="34" Height="34"
                                        Padding="0" Click="MemoryMinus_Click"/>
                                <TextBox x:Name="InputMemory" Style="{StaticResource Input}" Width="100"
                                         Margin="8,0,8,0" TextAlignment="Center"/>
                                <Button Style="{StaticResource BtnGhost}" Content="+" Width="34" Height="34"
                                        Padding="0" Click="MemoryPlus_Click"/>
                                <TextBlock x:Name="MemoryHint" Style="{StaticResource TCaption}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="附加 JVM 参数"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="InputJvm" Grid.Column="1" Style="{StaticResource Input}"
                                     Height="34" ToolTip="例如 -XX:+UseG1GC"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 启动 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="启动"/>
                        <StackPanel Margin="0,14,0,0">
                            <CheckBox x:Name="ChkResolution" Style="{StaticResource Chk}" Content="自定义窗口分辨率"/>
                            <Grid Margin="24,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InputWidth" Grid.Column="0" Style="{StaticResource Input}"
                                         Width="80" TextAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="×" Style="{StaticResource TSub}"
                                           Margin="10,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="InputHeight" Grid.Column="2" Style="{StaticResource Input}"
                                         Width="80" TextAlignment="Center"/>
                            </Grid>
                            <CheckBox x:Name="ChkMinimize" Style="{StaticResource Chk}" Margin="0,14,0,0"
                                      Content="启动游戏后最小化启动器"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 下载 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="下载源"/>
                        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"
                                   Text="国内网络建议使用 BMCLAPI 镜像，速度更快。"/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ChipMirror" Style="{StaticResource Chip}" Content="BMCLAPI 镜像"
                                          Click="Source_Click"/>
                            <ToggleButton x:Name="ChipOfficial" Style="{StaticResource Chip}" Content="Mojang 官方"
                                          Click="Source_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TSection}" Text="关于"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="版本"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource TBody}" Text="SlopeX Launcher 1.0.0"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="配置文件"/>
                            <TextBlock x:Name="ConfigPath" Grid.Column="1" Style="{StaticResource TMono}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TSub}" Text="架构参考"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource TSub}" TextWrapping="Wrap"
                                       Text="模块分层参考 PCL2（ModBase / ModNet / ModMinecraft / ModJava / ModLaunch / ModDownload），代码为独立实现。"/>
                        </Grid>
                        <Button Style="{StaticResource BtnGhost}" Content="打开配置目录" Height="30"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenConfigDir_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
