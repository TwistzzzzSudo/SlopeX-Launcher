<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SlopeX</AssemblyName>
    <RootNamespace>SlopeX</RootNamespace>
    <!-- 图标只有一个来源：仓库根目录的 ico/SlopeX.ico（由 tools/make-icon.ps1 生成） -->
    <ApplicationIcon>..\..\ico\SlopeX.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>SlopeX</Company>
    <Product>SlopeX Launcher</Product>
    <StartupObject>SlopeX.App</StartupObject>
    <!-- 允许在只装了更高版本（如 .NET 10）运行时的机器上直接运行 -->
    <RollForward>LatestMajor</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS1998;CS0168;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同一份 ico 也作为 WPF 资源嵌入，供窗口 / 任务栏图标使用（复制进包，不重复维护副本） -->
    <Resource Include="..\..\ico\SlopeX.ico" Link="Assets\SlopeX.ico" />

    <!--
      主题素材（插画 + 背景音乐）是可选的：它们是私人素材，不进仓库。
      Condition="Exists(...)" 让"没有素材的干净克隆"也能编译通过 ——
      主题会退化为纯渐变背景、无背景音乐（见 Themes/ArtSource.cs 与 ThemeMusic）。
    -->
    <Resource Include="..\..\art\vicecity.jpg" Link="Assets\vicecity.jpg"
              Condition="Exists('$(MSBuildThisFileDirectory)..\..\art\vicecity.jpg')" />
    <Resource Include="..\..\art\retro-future.jpg" Link="Assets\retro-future.jpg"
              Condition="Exists('$(MSBuildThisFileDirectory)..\..\art\retro-future.jpg')" />
    <Resource Include="..\..\music\vicecity.mp3" Link="music\vicecity.mp3"
              Condition="Exists('$(MSBuildThisFileDirectory)..\..\music\vicecity.mp3')" />
    <Resource Include="..\..\music\retro-future.mp3" Link="music\retro-future.mp3"
              Condition="Exists('$(MSBuildThisFileDirectory)..\..\music\retro-future.mp3')" />
  </ItemGroup>

</Project>
