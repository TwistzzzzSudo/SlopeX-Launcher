<UserControl x:Class="SlopeX.Controls.LoginDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <StackPanel>
        <TextBlock Style="{StaticResource TSection}" Text="登录微软账号"/>
        <TextBlock Style="{StaticResource TCaption}" Margin="0,5,0,14" TextWrapping="Wrap"
                   Text="在浏览器打开下面的网址并输入代码。密码只输入给微软，启动器不会接触。"/>

        <Border Background="{DynamicResource Paper2}" CornerRadius="{StaticResource R10}" Padding="18,14">
            <StackPanel>
                <TextBlock Text="代码" Style="{StaticResource TCaption}"/>
                <TextBlock x:Name="CodeText" Text="········" FontSize="26" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" Margin="0,6,0,0"
                           FontFamily="{StaticResource MonoFont}"/>
                <TextBlock x:Name="LinkText" Text="正在获取…" Style="{StaticResource TMono}"
                           Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource BtnGhost}" Content="打开登录页" Click="OpenLink_Click"/>
            <Button Style="{StaticResource BtnGhost}" Content="复制代码" Margin="8,0,0,0"
                    Click="CopyCode_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Style="{StaticResource TCaption}" Margin="0,12,0,0"
                   TextWrapping="Wrap" Text="正在向微软申请设备码…"/>

        <Grid Margin="0,14,0,0">
            <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="88"
                    HorizontalAlignment="Left" Click="Cancel_Click"/>
        </Grid>
    </StackPanel>
</UserControl>
