<UserControl x:Class="SlopeX.Controls.InstallChoiceDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">

    <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource TSection}" Text="安装版本"/>
        <TextBlock x:Name="HintText" Style="{StaticResource TCaption}" Margin="0,5,0,14" TextWrapping="Wrap"
                   Text="选择要安装的类型，然后开始安装。"/>

        <RadioButton x:Name="OptVanilla" Style="{StaticResource OptionRow}" GroupName="kind" IsChecked="True">
            <StackPanel>
                <TextBlock Text="原版" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}"/>
                <TextBlock x:Name="VanillaDesc" Style="{StaticResource TCaption}" Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Text="官方纯净客户端，不含模组加载器。"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="OptFabric" Style="{StaticResource OptionRow}" GroupName="kind">
            <StackPanel>
                <TextBlock Text="Fabric" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}"/>
                <TextBlock Style="{StaticResource TCaption}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="轻量模组加载器，优化与辅助类模组基本都走它。"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="OptForge" Style="{StaticResource OptionRow}" GroupName="kind" IsEnabled="False">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Forge" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Tag}" Margin="8,0,0,0">
                        <TextBlock Text="即将支持" FontSize="11"
                                   Foreground="{DynamicResource Muted}"/>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource TCaption}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="经典模组加载器，大型整合包常用。安装器尚未实装。"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="OptNeoForge" Style="{StaticResource OptionRow}" GroupName="kind" IsEnabled="False">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NeoForge" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Tag}" Margin="8,0,0,0">
                        <TextBlock Text="即将支持" FontSize="11"
                                   Foreground="{DynamicResource Muted}"/>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource TCaption}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Forge 的社区分支，新版本模组逐渐迁到这里。安装器尚未实装。"/>
            </StackPanel>
        </RadioButton>

        <Grid Margin="0,10,0,0">
            <Button Style="{StaticResource BtnGhost}" Content="取消" MinWidth="88"
                    HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button Style="{StaticResource BtnPrimary}" Content="开始安装" Height="36" Padding="18,0"
                    HorizontalAlignment="Right" Click="Ok_Click"/>
        </Grid>
    </StackPanel>
</UserControl>
