<UserControl x:Class="SlopeX.Controls.UpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        发现新版本：版本号 + 更新说明 + 下载进度 + 两个按钮。
        下载与替换都由调用方负责，这里只显示进度、收集「现在装 / 稍后」。
    -->

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Border Width="3" Height="16" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource Good}"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource TSection}" Margin="10,0,0,0"
                       Text="发现新版本"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource TCaption}" Text="当前" VerticalAlignment="Center"/>
            <TextBlock x:Name="CurrentText" Style="{StaticResource TBody}" Margin="6,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource TCaption}" Text="→" Margin="10,0,10,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="NewText" Style="{StaticResource TBody}" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer x:Name="NotesBox" MaxHeight="180" VerticalScrollBarVisibility="Auto"
                      Margin="0,12,0,0">
            <TextBlock x:Name="NotesText" Style="{StaticResource TCaption}" TextWrapping="Wrap"/>
        </ScrollViewer>

        <StackPanel x:Name="ProgressRow" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" Style="{StaticResource TCaption}"
                       HorizontalAlignment="Right" Text=""/>
            <ProgressBar x:Name="DownloadBar" Style="{StaticResource Bar}" Height="4"
                         Margin="0,4,0,0" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Style="{StaticResource TCaption}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Bad}" Margin="0,12,0,0" Visibility="Collapsed"/>

        <Grid Margin="0,18,0,0">
            <Button x:Name="CancelBtn" Style="{StaticResource BtnGhost}" Content="稍后" Height="36"
                    MinWidth="96" HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Style="{StaticResource BtnPrimary}" Content="立即更新" Height="36"
                    Padding="18,0" HorizontalAlignment="Right" Click="Ok_Click"/>
        </Grid>
    </StackPanel>
</UserControl>
