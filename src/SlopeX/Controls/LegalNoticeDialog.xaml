<UserControl x:Class="SlopeX.Controls.LegalNoticeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <!-- 法律声明：正文来自内置资源（docs/LegalNotice.md 编译进 exe），不读外部文件 -->

    <StackPanel>
        <Grid>
            <TextBlock Style="{StaticResource TSub}" FontWeight="SemiBold" Text="法律声明"/>
            <Button Style="{StaticResource BtnText}" Content="已明白" HorizontalAlignment="Right"
                    Click="Close_Click"/>
        </Grid>

        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,12" TextWrapping="Wrap"
                   Text="使用 SlopeX Launcher 即视为同意以下全部条款。"/>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <FlowDocumentScrollViewer x:Name="DocView" MaxHeight="392" Padding="0"
                                      Background="Transparent"
                                      VerticalScrollBarVisibility="Auto"
                                      IsToolBarVisible="False"/>
        </Border>
    </StackPanel>
</UserControl>
