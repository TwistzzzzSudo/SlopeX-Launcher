<UserControl x:Class="SlopeX.Controls.ModSearchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <!-- 模组搜索：只有一个来源 Modrinth（免 Key），不再做多来源切换 -->

    <StackPanel>
        <Grid>
            <TextBlock x:Name="TitleText" Style="{StaticResource TSub}" FontWeight="SemiBold" Text="添加模组"/>
            <Button Style="{StaticResource BtnText}" Content="关闭" HorizontalAlignment="Right"
                    Click="Close_Click"/>
        </Grid>

        <TextBlock x:Name="TargetText" Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="QueryBox" Style="{StaticResource Input}" KeyDown="Query_KeyDown"/>
                <TextBlock Text="搜索模组名…" Foreground="{DynamicResource Muted}" FontSize="12.5"
                           Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="搜索" Margin="8,0,0,0"
                    Click="Search_Click"/>
        </Grid>

        <TextBlock x:Name="StatusText" Style="{StaticResource TCaption}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Text="输入关键词后回车搜索。"/>

        <Border Style="{StaticResource Card}" Padding="4" Margin="0,10,0,0" MaxHeight="330">
            <ListBox x:Name="ResultList" Style="{StaticResource PlainList}" MaxHeight="322">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DataListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                                    <TextBlock Text="{Binding SubText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource BtnText}" Content="安装"
                                        Tag="{Binding}" Click="Install_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </StackPanel>
</UserControl>
