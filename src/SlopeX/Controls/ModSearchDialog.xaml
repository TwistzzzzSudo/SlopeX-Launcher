<UserControl x:Class="SlopeX.Controls.ModSearchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <!-- 模组搜索：中文关键词走 MC百科 检索再对回 Modrinth，英文直接搜 Modrinth -->

    <StackPanel>
        <Grid>
            <TextBlock x:Name="TitleText" Style="{StaticResource TSub}" FontWeight="SemiBold" Text="添加模组"/>
            <Button Style="{StaticResource BtnText}" Content="关闭" HorizontalAlignment="Right"
                    Click="Close_Click"/>
        </Grid>

        <TextBlock x:Name="TargetText" Style="{StaticResource TCaption}" Margin="0,4,0,14" TextWrapping="Wrap"/>

        <!-- 来源筛选：单选 Modrinth 走官方接口，全部模式两个平台一起搜（都经 MCIM 镜像） -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ToggleButton x:Name="ChipAll" Style="{StaticResource Chip}" Content="全部"
                          IsChecked="True" Click="Source_Click"
                          ToolTip="Modrinth 与 CurseForge 一起搜，结果去重后合并"/>
            <ToggleButton x:Name="ChipModrinth" Style="{StaticResource Chip}" Content="Modrinth"
                          Click="Source_Click"
                          ToolTip="只搜 Modrinth，走官方接口（数据最新）"/>
            <ToggleButton x:Name="ChipCurseForge" Style="{StaticResource Chip}" Content="CurseForge"
                          Click="Source_Click"
                          ToolTip="只搜 CurseForge（经 MCIM 镜像）"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="QueryBox" Style="{StaticResource Input}" KeyDown="Query_KeyDown"/>
                <TextBlock Text="搜中文名也行，比如「机械动力」「钠」" Foreground="{DynamicResource Muted}" FontSize="12.5"
                           Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource BtnGhost}" Content="搜索" Click="Search_Click"/>
                <!-- 兜底：映射不到 Modrinth 的（比如只在 CurseForge 上架的）直接在百科里看 -->
                <Button Style="{StaticResource BtnText}" Content="去百科" Margin="6,0,0,0"
                        ToolTip="在 MC百科 里搜索这个关键词"
                        Click="OpenWiki_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Style="{StaticResource TCaption}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Text="输入关键词后回车搜索，中文英文都行。"/>

        <!-- 下载进度：只在安装期间出现。文字单独一行右对齐，窄对话框里也不会被进度条挤掉 -->
        <StackPanel x:Name="ProgressRow" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" Style="{StaticResource TCaption}"
                       HorizontalAlignment="Right" Text=""/>
            <ProgressBar x:Name="DownloadBar" Style="{StaticResource Bar}" Height="4"
                         Margin="0,4,0,0" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="4" Margin="0,10,0,0" MaxHeight="330">
            <ListBox x:Name="ResultList" Style="{StaticResource PlainList}" MaxHeight="322">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DataListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 平台上的项目图标；没有时显示首字母占位 -->
                                    <Grid Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Border CornerRadius="8" Background="{DynamicResource Paper2}"/>
                                        <TextBlock Text="{Binding Initial}" FontSize="14"
                                                   Foreground="{DynamicResource Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding IconData, Converter={StaticResource Icon}}"
                                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <StackPanel VerticalAlignment="Center">
                                        <!-- 来源做成小胶囊：两个平台混排时，靠小字里的一个词分不清 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{DynamicResource Paper3}"
                                                    CornerRadius="3" Padding="5,1,5,1" Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceText}" FontSize="10"
                                                           Foreground="{DynamicResource Sub}"/>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding SubText}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Muted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 只有来自 MC百科 的结果才有词条可看 -->
                                    <Button Style="{StaticResource BtnText}" Content="百科" Margin="0,0,2,0"
                                            Tag="{Binding}" Click="Wiki_Click"
                                            Visibility="{Binding HasMcMod, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource BtnText}" Content="安装"
                                            Tag="{Binding}" Click="Install_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </StackPanel>
</UserControl>
