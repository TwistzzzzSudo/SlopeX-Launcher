<UserControl x:Class="SlopeX.Controls.LegalGateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <!--
        首次启动的法律声明确认框（简版，不含仓库地址与联系方式）。
        没有关闭按钮、没有 Esc 退路：要么勾选后确认，要么退出程序——
        一个能被随手关掉的"同意"没有意义。
    -->

    <StackPanel>
        <TextBlock Style="{StaticResource TSub}" FontWeight="SemiBold" Text="法律声明"/>

        <TextBlock Style="{StaticResource TCaption}" Margin="0,4,0,12" TextWrapping="Wrap"
                   Text="以下是使用本启动器需要知晓的要点，完整条款可在「设置 → 法律声明」中随时查看。"/>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <FlowDocumentScrollViewer x:Name="DocView" MaxHeight="272" Padding="0"
                                      Background="Transparent"
                                      VerticalScrollBarVisibility="Auto"
                                      IsToolBarVisible="False"/>
        </Border>

        <CheckBox x:Name="AgreeBox" Style="{StaticResource Chk}" Margin="0,14,0,0"
                  Checked="Agree_Changed" Unchecked="Agree_Changed">
            <TextBlock TextWrapping="Wrap" MaxWidth="430"
                       Text="在您使用SlopeX Launcher时，将默认您同意以上所有法律条款。"/>
        </CheckBox>

        <Grid Margin="0,16,0,0">
            <TextBlock x:Name="HintText" Style="{StaticResource TCaption}" VerticalAlignment="Center"
                       Text="勾选后才能继续。"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnGhost}" Content="退出" Height="34" Click="Quit_Click"/>
                <Button x:Name="ConfirmBtn" Style="{StaticResource BtnPrimary}" Content="确认" Height="34"
                        Margin="8,0,0,0" IsEnabled="False" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
