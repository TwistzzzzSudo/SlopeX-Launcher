<UserControl x:Class="SlopeX.Controls.ModsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <!--
        模组管理面板：挂在版本管理页上，覆盖在版本列表之上。
        数据与操作全部走 Modules.ModMods.ModManager，这里只管展示与确认。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BtnGhost}" Content="‹ 返回" Click="Back_Click"/>
                    <TextBlock x:Name="TitleText" Style="{StaticResource TTitle}" Margin="14,0,0,0"
                               VerticalAlignment="Center" Text="模组管理"/>
                </StackPanel>
                <TextBlock x:Name="SubText" Style="{StaticResource TSub}" Margin="80,4,0,0" Text=""/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnGhost}" Content="打开目录" Click="OpenDir_Click"/>
                <Button Style="{StaticResource BtnGhost}" Content="刷新" Margin="8,0,0,0"
                        Click="Refresh_Click"/>
                <Button Style="{StaticResource BtnPrimary}" Content="添加模组" Height="32" Padding="16,0"
                        Margin="8,0,0,0" Click="AddMod_Click" ToolTip="从 Modrinth 搜索并安装（CurseForge 需 API Key）"/>
            </StackPanel>
        </Grid>

        <!-- 列头 -->
        <Grid Grid.Row="1" Margin="14,0,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="118"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource DataListHeader}" Text="状态"/>
            <TextBlock Grid.Column="1" Style="{StaticResource DataListHeader}" Text="名称"/>
            <TextBlock Grid.Column="2" Style="{StaticResource DataListHeader}" Text="版本"/>
            <TextBlock Grid.Column="3" Style="{StaticResource DataListHeader}" Text="大小"/>
            <TextBlock Grid.Column="4" Style="{StaticResource DataListHeader}" Text="文件名"/>
            <TextBlock Grid.Column="5" Style="{StaticResource DataListHeader}" Text="操作"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,8,8,8">
            <Grid>
                <ListBox x:Name="ModList" Style="{StaticResource PlainList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DataListRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="118"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 状态 -->
                                    <Border Grid.Column="0" Style="{StaticResource Tag}"
                                            Background="{DynamicResource Paper2}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"
                                                   Text="{Binding StateText}"/>
                                    </Border>

                                    <!-- 名称 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                   ToolTip="{Binding Title}"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Muted}"
                                                   Margin="0,1,0,0"
                                                   Text="{Binding LoaderHint}"/>
                                    </StackPanel>

                                    <!-- 版本 -->
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Style="{StaticResource TCaption}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Version}"
                                               Text="{Binding Version}"/>

                                    <!-- 大小 -->
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                               Style="{StaticResource TCaption}"
                                               Text="{Binding SizeText}"/>

                                    <!-- 文件名 -->
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0"
                                               FontSize="11" Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FileName}"
                                               Text="{Binding FileName}"/>

                                    <!-- 操作 -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BtnText}" Click="Toggle_Click" Tag="{Binding}"
                                                Content="{Binding ToggleText}" ToolTip="启用 / 禁用（改名 .disabled）"/>
                                        <Button Style="{StaticResource BtnText}" Margin="10,0,0,0" Tag="{Binding}"
                                                Foreground="{DynamicResource Bad}"
                                                Click="Delete_Click" Content="删除"
                                                ToolTip="删除这个模组文件"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Style="{StaticResource EmptyTitle}" Text="这个版本还没有装模组"/>
                    <TextBlock Style="{StaticResource EmptyHint}"
                               Text="把 .jar 文件放进 versions\&lt;版本&gt;\mods\ 文件夹即可，加载器会自动忽略 .disabled 结尾的文件"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
