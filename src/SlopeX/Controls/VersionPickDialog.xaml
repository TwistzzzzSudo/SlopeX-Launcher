<UserControl x:Class="SlopeX.Controls.VersionPickDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Focusable="True" PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        普通压缩包没有版本清单，导入前必须挑一个已安装的原版版本当基础。
        不自带业务逻辑：点「导入」发选中的版本 ID，取消 / Esc 发 null。
    -->

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Border Width="3" Height="16" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource Primary}"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource TSection}" Margin="10,0,0,0"
                       Text="选择基础版本"/>
        </StackPanel>

        <TextBlock x:Name="MessageText" Style="{StaticResource TCaption}" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" Text=""/>

        <ListBox x:Name="VersionList" Style="{StaticResource PlainList}"
                 ItemContainerStyle="{StaticResource RowItemPick}" MaxHeight="240"
                 Margin="0,12,0,0" MouseDoubleClick="VersionList_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Id}" Style="{StaticResource TBody}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource TCaption}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Margin="0,18,0,0">
            <Button x:Name="CancelBtn" Style="{StaticResource BtnGhost}" Content="取消" Height="36"
                    MinWidth="96" HorizontalAlignment="Left" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Style="{StaticResource BtnPrimary}" Content="导入" Height="36"
                    Padding="18,0" HorizontalAlignment="Right" Click="Ok_Click"/>
        </Grid>
    </StackPanel>
</UserControl>
