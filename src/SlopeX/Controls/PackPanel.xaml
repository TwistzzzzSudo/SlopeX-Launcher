<UserControl x:Class="SlopeX.Controls.PackPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <!--
        资源包面板：光影 / 材质包的搜索与下载，挂在版本管理页上，和模组面板同样是"整页替换"。
        与模组面板最大的区别：不按 MC 版本 / 加载器过滤，版本由用户自己挑（见 PackInstaller 的注释）。
    -->

    <UserControl.Resources>
        <!--
            版本浮层里的一行：整行就是一个按钮，点中直接开下载。
            不用 ListBoxItem 承接点击，是因为主题里的 RowItem 把 Focusable 设成了 False，
            WPF 的 ListBoxItem 没焦点就不会被鼠标选中（SelectionChanged 永远不触发）。
        -->
        <Style x:Key="VersionPickRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R8}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Paper2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Paper3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BtnGhost}" Content="‹ 返回" Click="Back_Click"/>
                    <TextBlock Style="{StaticResource TTitle}" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="资源包"/>
                </StackPanel>
                <TextBlock x:Name="SubText" Style="{StaticResource TSub}" Margin="80,4,0,0" Text=""/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource BtnGhost}" Content="打开目录" Click="OpenDir_Click"
                        ToolTip="打开当前类型的资源包目录"/>
                <Button Style="{StaticResource BtnGhost}" Content="刷新" Margin="8,0,0,0" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- 类型页签 + 搜索 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="ChipShader" Style="{StaticResource Chip}" Content="光影包"
                              IsChecked="True" Click="Kind_Click"/>
                <ToggleButton x:Name="ChipPack" Style="{StaticResource Chip}" Content="材质包"
                              Margin="8,0,0,0" Click="Kind_Click"/>
            </StackPanel>

            <Grid HorizontalAlignment="Right" Width="360">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="QueryBox" Style="{StaticResource Input}" KeyDown="Query_KeyDown"/>
                    <TextBlock Text="搜索光影 / 材质包，如 complementary、bsl…"
                               Foreground="{DynamicResource Muted}" FontSize="12.5"
                               Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="搜索" Margin="8,0,0,0"
                        Click="Search_Click"/>
            </Grid>
        </Grid>

        <!-- 光影加载器提示：光影页签常驻，不用 Toast（一闪就没） -->
        <Border x:Name="ShaderHint" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,10"
                Background="{DynamicResource Paper2}" CornerRadius="{StaticResource R8}"
                Padding="14,10">
            <StackPanel>
                <TextBlock FontSize="12.5" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"
                           Text="光影需要额外的加载器才生效：Fabric 装 Iris + Sodium；Forge / NeoForge 装 Oculus（一般配 Embeddium），或直接用 OptiFine。只把 .zip 放进 shaderpacks 是看不到光影的。"/>
                <TextBlock Style="{StaticResource TCaption}" Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="下面的包不按 MC 版本过滤，装之前请自己确认它支持的范围。"/>
            </StackPanel>
        </Border>

        <!-- 状态行 + 下载进度 -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Style="{StaticResource TCaption}"
                       TextWrapping="Wrap" Text="输入关键词搜索；点结果行的「安装」，挑一个版本就会立刻下载。"/>

            <!-- 只在下载期间出现：平时不占视觉重量。
                 文字单独一行右对齐，不和进度条抢宽度（窄窗口下进度条会把文字挤出边界）。 -->
            <StackPanel x:Name="ProgressRow" Margin="0,6,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" Style="{StaticResource TCaption}"
                           HorizontalAlignment="Right" Text=""/>
                <ProgressBar x:Name="DownloadBar" Style="{StaticResource Bar}" Height="4"
                             Margin="0,4,0,0" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </StackPanel>

        <!-- 列表 -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="112"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource DataListHeader}" Text="名称"/>
                <TextBlock Grid.Column="1" Style="{StaticResource DataListHeader}" Text="支持版本"/>
                <TextBlock Grid.Column="2" Style="{StaticResource DataListHeader}" Text="更新"/>
                <TextBlock Grid.Column="3" Style="{StaticResource DataListHeader}" Text="操作"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox x:Name="PackList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DataListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="196"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 平台上的项目图标；没有时显示首字母占位 -->
                                            <Grid Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border CornerRadius="8" Background="{DynamicResource Paper2}"/>
                                                <TextBlock Text="{Binding Hit.Initial}" FontSize="14"
                                                           Foreground="{DynamicResource Muted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Hit.IconData, Converter={StaticResource Icon}}"
                                                                    Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Ink}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="360"
                                                           ToolTip="{Binding TooltipText}"/>
                                                <TextBlock Text="{Binding SubTitle}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="360"
                                                           ToolTip="{Binding Description}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   Style="{StaticResource TCaption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding SupportText}"/>

                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   Style="{StaticResource TCaption}"
                                                   Text="{Binding UpdatedText}"/>

                                        <Button Grid.Column="3" Style="{StaticResource BtnText}" Tag="{Binding}"
                                                Click="ChooseVersion_Click" MinWidth="78"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                AutomationProperties.Name="安装"
                                                ToolTip="选一个包版本，点完立刻开始下载">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="安装"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="9" Margin="5,1,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" Style="{StaticResource EmptyTitle}"
                                   Text="还没有搜到内容"/>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource EmptyHint}"
                                   Text="上面输入关键词，比如 complementary（光影）或 stay-true（材质）"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 版本选择浮层：点「安装」时贴在该按钮下方，点中哪个版本就开始下载哪个 -->
        <Popup x:Name="VersionPopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="4" HorizontalOffset="-40"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource R8}"
                    BorderThickness="1" BorderBrush="{DynamicResource Line}" Padding="4"
                    Width="330" MaxHeight="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="VersionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource VersionPickRow}" Tag="{Binding}"
                                        Click="VersionPick_Click"
                                        ToolTip="{Binding SubText}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding VersionNumber}" FontSize="12.5"
                                                   Foreground="{DynamicResource Ink}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SubText}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Muted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
